# Environment variables for Yellow ERP
# Copy this template to .env.local or your hosting provider variables

# PostgreSQL Connection String
# Get from your PostgreSQL provider or local PostgreSQL
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/yellow_erp

# SSL for PostgreSQL. Set to 'false' if your server doesn't support SSL (e.g. Coolify Postgres)
DATABASE_SSL=true

# JWT Secret for authentication
# IMPORTANTE: genera un secreto aleatorio fuerte (min 32 caracteres).
# NUNCA reutilices este valor de ejemplo en producción.
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars

# Secreto para el endpoint de seed demo (opcional; usa JWT_SECRET por defecto)
SEED_SECRET=replace_with_a_strong_random_secret

# Contraseña del admin demo sembrado (opcional)
SEED_ADMIN_PASSWORD=replace_with_a_strong_password_for_demo

# Public URL of your application (without trailing slash)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Admin credentials for initial setup (optional)
# These are used during initial database setup
ADMIN_EMAIL=admin@yellow-erp.cl
SEED_ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN
